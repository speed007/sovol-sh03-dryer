# Copy this file to `secrets.yaml` and fill in your own values.
#   cd esphome && cp secrets.yaml.example secrets.yaml
# `secrets.yaml` is git-ignored — never commit real credentials.

wifi_ssid: "your-2.4GHz-ssid"
wifi_password: "your-wifi-password"

# 32-byte base64 key. ESPHome will generate one if you run the wizard, or use
# any 44-char base64 string.
api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY="

# Password for the fallback hotspot the ESP raises if WiFi fails.
ap_password: "fallback-hotspot-password"
